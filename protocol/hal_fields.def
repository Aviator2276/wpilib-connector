// ---------------------------------------------------------- Addressable LED
// The pixel data is an array and is carried by a dedicated message.
WEBSIM_CLASS(AddressableLED, "AddressableLED", HAL_GetNumAddressableLEDs())
WEBSIM_FIELD(AddressableLED, AddressableLED, Initialized, boolean, HAL_Bool, OUT, "<init")
WEBSIM_FIELD(AddressableLED, AddressableLED, OutputPort, int, int32_t, OUT, "<output_port")
WEBSIM_FIELD(AddressableLED, AddressableLED, Length, int, int32_t, OUT, "<length")
WEBSIM_FIELD(AddressableLED, AddressableLED, Running, boolean, HAL_Bool, OUT, "<running")

#undef WEBSIM_CLASS
#undef WEBSIM_FIELD
#undef WEBSIM_FIELD0
#undef WEBSIM_FIELD2

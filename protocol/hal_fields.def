WEBSIM_FIELD(AnalogGyro, AnalogGyro, Rate, double, double, IN, nullptr)

// --------------------------------------------------- Built-in accelerometer
// JSON: type "Accel", device "BuiltInAccel"; "<range" is in G (codec).
WEBSIM_CLASS(Accelerometer, "Accel", 1)
WEBSIM_FIELD(Accelerometer, Accelerometer, Active, boolean, HAL_Bool, OUT, "<init")
WEBSIM_FIELD(Accelerometer, Accelerometer, Range, enum, HAL_AccelerometerRange, OUT, nullptr)
WEBSIM_FIELD(Accelerometer, Accelerometer, X, double, double, IN, ">x")
WEBSIM_FIELD(Accelerometer, Accelerometer, Y, double, double, IN, ">y")
WEBSIM_FIELD(Accelerometer, Accelerometer, Z, double, double, IN, ">z")

// --------------------------------------------------- Digital PWM (dPWM out)
WEBSIM_CLASS(DigitalPWM, "dPWM", HAL_GetNumDigitalPWMOutputs())
WEBSIM_FIELD(DigitalPWM, DigitalPWM, Initialized, boolean, HAL_Bool, OUT, "<init")
WEBSIM_FIELD(DigitalPWM, DigitalPWM, DutyCycle, double, double, OUT, "<duty_cycle")
WEBSIM_FIELD(DigitalPWM, DigitalPWM, Pin, int, int32_t, OUT, "<dio_pin")

// --------------------------------------------------------- Duty cycle input

WEBSIM_FIELD0(RoboRio, RoboRio, UserFaults6V, int, int32_t, IN, ">6v_faults")
WEBSIM_FIELD0(RoboRio, RoboRio, UserVoltage5V, double, double, IN, ">5v_voltage")
WEBSIM_FIELD0(RoboRio, RoboRio, UserCurrent5V, double, double, IN, ">5v_current")
WEBSIM_FIELD0(RoboRio, RoboRio, UserActive5V, boolean, HAL_Bool, IN, ">5v_active")
WEBSIM_FIELD0(RoboRio, RoboRio, UserFaults5V, int, int32_t, IN, ">5v_faults")
WEBSIM_FIELD0(RoboRio, RoboRio, UserVoltage3V3, double, double, IN, ">3v3_voltage")
WEBSIM_FIELD0(RoboRio, RoboRio, UserCurrent3V3, double, double, IN, ">3v3_current")

WEBSIM_FIELD0(RoboRio, RoboRio, UserFaults3V3, int, int32_t, IN, ">3v3_faults")
WEBSIM_FIELD0(RoboRio, RoboRio, BrownoutVoltage, double, double, IN, nullptr)
WEBSIM_FIELD0(RoboRio, RoboRio, TeamNumber, int, int32_t, IN, nullptr)
WEBSIM_FIELD0(RoboRio, RoboRio, CPUTemp, double, double, IN, nullptr)
WEBSIM_FIELD0(RoboRio, RoboRio, RadioLEDState, enum, HAL_RadioLEDState, OUT, nullptr)

// ---------------------------------------------------------------------- PWM
WEBSIM_CLASS(PWM, "PWM", HAL_GetNumPWMChannels())
WEBSIM_FIELD(PWM, PWM, Initialized, boolean, HAL_Bool, OUT, "<init")

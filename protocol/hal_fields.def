// The HAL device table shared by both ends of the web sim:
//
//   - the mirror HAL in the browser (wasm/src/mirror*.cpp), which applies
//     these values to its local sim HAL and sends GUI edits back, and
//   - the native bridge in the robot process (bridge/), which reports them.
//
// Every row names a real HALSIM accessor triple, so a row that drifts from
// the HAL headers fails to compile on both sides:
//
//   HALSIM_Set<mod><name>(...)   HALSIM_Register<mod><name>Callback(...)
//
// Row forms (X-macros; define before including, they are #undef'd at the end):
//
//   WEBSIM_CLASS(cls, wsType, count)
//       Starts a device class. `wsType` is its "type" in the stock halsim_ws
//       JSON protocol (nullptr when that protocol has no such message).
//       `count` is the number of instances; 1 with FIELD0 rows for singletons.
//
//   WEBSIM_FIELD(cls, mod, name, haltype, ctype, dir, wsKey)
//       accessor(index, value)
//   WEBSIM_FIELD0(cls, mod, name, haltype, ctype, dir, wsKey)
//       accessor(value)                      -- singleton, no index
//   WEBSIM_FIELD2(cls, mod, name, haltype, ctype, dir, wsKey, channels)
//       accessor(index, channel, value)      -- wire index = index*256+channel
//
//   haltype  member of HAL_Value's union: boolean, double, int, long, enum
//   ctype    C type the setter takes
//   dir      OUT   written by the robot program, read-only in the GUI
//            IN    an input to the robot program, editable in the GUI
//            BIDIR both
//   wsKey    data key in the halsim_ws JSON protocol, or nullptr if the stock
//            protocol does not carry the value (bridge only)
//
// Classes and fields are numbered by position in this file. Both ends are
// always built from the same copy and exchange a hash of it on connect, so
// rows may be added or reordered freely.

// ------------------------------------------------------------ DriverStation
WEBSIM_CLASS(DriverStation, "DriverStation", 1)
WEBSIM_FIELD0(DriverStation, DriverStation, Enabled, boolean, HAL_Bool, IN, ">enabled")
WEBSIM_FIELD0(DriverStation, DriverStation, Autonomous, boolean, HAL_Bool, IN, ">autonomous")
WEBSIM_FIELD0(DriverStation, DriverStation, Test, boolean, HAL_Bool, IN, ">test")
WEBSIM_FIELD0(DriverStation, DriverStation, EStop, boolean, HAL_Bool, IN, ">estop")
WEBSIM_FIELD0(DriverStation, DriverStation, FmsAttached, boolean, HAL_Bool, IN, ">fms")
WEBSIM_FIELD0(DriverStation, DriverStation, DsAttached, boolean, HAL_Bool, IN, ">ds")
// JSON carries the station as a string (">station"); handled by the codec.
WEBSIM_FIELD0(DriverStation, DriverStation, AllianceStationId, enum, HAL_AllianceStationID, IN, nullptr)
WEBSIM_FIELD0(DriverStation, DriverStation, MatchTime, double, double, IN, ">match_time")


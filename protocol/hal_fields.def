// JSON: type "Solenoid", device "<module>,<channel>".
WEBSIM_CLASS(CTREPCMSolenoid, "Solenoid", HAL_GetNumCTREPCMModules())
WEBSIM_FIELD2(CTREPCMSolenoid, CTREPCM, SolenoidOutput, boolean, HAL_Bool, OUT, "<output", HAL_GetNumCTRESolenoidChannels())


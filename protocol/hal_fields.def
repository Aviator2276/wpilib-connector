WEBSIM_FIELD(DutyCycle, DutyCycle, Output, double, double, IN, nullptr)

// ------------------------------------------------------------------ Encoder
// The A/B channel numbers have no change callback; both codecs send them
// alongside Initialized.
WEBSIM_CLASS(Encoder, "Encoder", HAL_GetNumEncoders())
WEBSIM_FIELD(Encoder, Encoder, Initialized, boolean, HAL_Bool, OUT, "<init")
WEBSIM_FIELD(Encoder, Encoder, Count, int, int32_t, IN, ">count")
WEBSIM_FIELD(Encoder, Encoder, Period, double, double, IN, ">period")
WEBSIM_FIELD(Encoder, Encoder, Reset, boolean, HAL_Bool, BIDIR, nullptr)
WEBSIM_FIELD(Encoder, Encoder, MaxPeriod, double, double, OUT, nullptr)
WEBSIM_FIELD(Encoder, Encoder, Direction, boolean, HAL_Bool, IN, nullptr)
WEBSIM_FIELD(Encoder, Encoder, ReverseDirection, boolean, HAL_Bool, OUT, "<reverse_direction")
WEBSIM_FIELD(Encoder, Encoder, SamplesToAverage, int, int32_t, OUT, "<samples_to_avg")
WEBSIM_FIELD(Encoder, Encoder, DistancePerPulse, double, double, OUT, nullptr)

